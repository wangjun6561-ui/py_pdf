[Unit]
Description=Telegram Channel Monitor (Telethon + ServerChan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/py_pdf
ExecStart=/usr/bin/python3 /opt/py_pdf/main.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0
User=www-data
Group=www-data
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
